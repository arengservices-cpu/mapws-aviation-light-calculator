<div class="container">
  <h1>MAPWS Aviation Light Calculator</h1>
  <p>Map Worldwide Services | Aviation Obstacle Lighting</p>

  <h2>Project Information</h2>

  <label>Project Name</label>
  <input id="project" placeholder="Enter project name">

  <label>Site Location</label>
  <input id="location" placeholder="Enter site location">

  <h2>Building Details</h2>

  <label>Building Height (Metres)</label>
  <input id="height" type="number" min="0" step="0.01"
         placeholder="e.g. 120">

  <label>Building Length (Metres)</label>
  <input id="length" type="number" min="0" step="0.01"
         placeholder="e.g. 60">

  <label>Building Width (Metres)</label>
  <input id="width" type="number" min="0" step="0.01"
         placeholder="e.g. 30">

  <label>Number of Buildings</label>
  <input id="buildings" type="number" min="1" step="1"
         value="1">

  <label>Top Elevation AMSL (Metres, if known)</label>
  <input id="amsl" type="number" step="0.01"
         placeholder="Optional">

  <button onclick="generateReport()">Generate Project Summary</button>

  <div class="result" id="result"></div>

  <p class="small">
  Preliminary project data collection only. This version does
  not determine regulatory compliance or final light quantities.
  Final design requires applicable DGCA CAR, ICAO and airport
  requirements to be verified.
  </p>
