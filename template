<script>
function generateReport() {
  const project = document.getElementById("project").value.trim();
  const location = document.getElementById("location").value.trim();
  const height = Number(document.getElementById("height").value);
  const length = Number(document.getElementById("length").value);
  const width = Number(document.getElementById("width").value);
  const buildings = Number(document.getElementById("buildings").value);
  const amsl = document.getElementById("amsl").value;

  if (!project || !location || height <= 0 ||
      length <= 0 || width <= 0 ||
      !Number.isInteger(buildings) || buildings < 1) {
    alert("Please enter all required details correctly.");
    return;
  }

  const result = document.getElementById("result");
  result.style.display = "block";
  result.innerHTML = `
    <h2>Project Summary</h2>
    <b>Project:</b> ${escapeHTML(project)}<br>
    <b>Location:</b> ${escapeHTML(location)}<br>
    <b>Building Height:</b> ${height} metres<br>
    <b>Length:</b> ${length} metres<br>
    <b>Width:</b> ${width} metres<br>
    <b>Number of Buildings:</b> ${buildings}<br>
    <b>Top Elevation AMSL:</b> ${amsl === "" ? "Not provided" : Number(amsl) + " metres"}<br>
    <hr>
    <b>Status:</b> Project information recorded.<br>
    Lighting design and quantities: Pending engineering assessment.
  `;
}
function escapeHTML(value) {
  return value.replace(/[&<>"']/g, c => ({
    "&":"&amp;", "<":"&lt;", ">":"&gt;",
    '"':"&quot;", "'":"&#39;"
  })[c]);
}
</script>
